  "environment": "*",
  "entrypoints": {
    "main": ["com.myrin.tp.MyrinTPMod"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~26.3"
  }
}
