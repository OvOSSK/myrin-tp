  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.myrin.tp.MyrinTPMod"],
    "modmenu": ["com.myrin.tp.MyrinModMenu"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "~26.3"
  }
}
